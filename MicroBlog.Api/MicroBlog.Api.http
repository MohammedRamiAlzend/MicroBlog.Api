@MicroBlog.Api_HostAddress = http://localhost:5101

GET {{MicroBlog.Api_HostAddress}}/api/ping
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/status
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/articles
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/posts
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/1
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/user/1
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/search?term=net
Accept: application/json

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/count
Accept: application/json

###

POST {{MicroBlog.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "ahmed_dev",
  "email": "ahmed@example.com",
  "password": "SecurePassword123!",
  "bio": "Backend developer"
}

###

GET {{MicroBlog.Api_HostAddress}}/api/users/1
Accept: application/json

###

POST {{MicroBlog.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "ahmed_dev",
  "password": "SecurePassword123!"
}

###

@token = paste_the_token_from_login_here

GET {{MicroBlog.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

POST {{MicroBlog.Api_HostAddress}}/api/posts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Written by the logged-in user"
}

###

PUT {{MicroBlog.Api_HostAddress}}/api/posts/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Edited by the owner"
}

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/my-posts
Authorization: Bearer {{token}}

###

DELETE {{MicroBlog.Api_HostAddress}}/api/posts/1
Authorization: Bearer {{token}}

###

GET {{MicroBlog.Api_HostAddress}}/api/users/me
Authorization: Bearer {{token}}

###

GET {{MicroBlog.Api_HostAddress}}/api/users/claims
Authorization: Bearer {{token}}

###

PUT {{MicroBlog.Api_HostAddress}}/api/users/me/bio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bio": "Backend developer learning ASP.NET Core"
}

###

###

POST {{MicroBlog.Api_HostAddress}}/api/posts/1/like
Authorization: Bearer {{token}}

###

DELETE {{MicroBlog.Api_HostAddress}}/api/posts/1/like
Authorization: Bearer {{token}}

###

GET {{MicroBlog.Api_HostAddress}}/api/posts/1/comments
Accept: application/json

###

POST {{MicroBlog.Api_HostAddress}}/api/posts/1/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Nice post!"
}

###

DELETE {{MicroBlog.Api_HostAddress}}/api/posts/1/comments/1
Authorization: Bearer {{token}}
